# Use self-signed certificate for testing
SELF_SIGNED_CERT="false"
LETSENCRYPT_STAGING="false"
# Automatically determined if empty
PUBLIC_IP=""

# No CDN
# Owned certificate/local-site domain and the SNI used by REALITY clients.
REALITY_DOMAIN=""
# Optional comma-separated accepted REALITY names and exact SNI forwarding allowlist.
# Empty uses REALITY_DOMAIN and XHTTP_DOMAIN; REALITY_DOMAIN is always included.
# Listed external names expose an unauthenticated TLS relay to public TCP/443.
# Owned names, unlisted names and no-SNI traffic use the local website.
REALITY_SERVER_NAMES=""
# CDN
XHTTP_DOMAIN=""

XRAY_PATH="/my/very/long/path"

REALITY_DOMAIN_PROXY_SITE="www.example.com"
XHTTP_DOMAIN_PROXY_SITE="www.example.com"
