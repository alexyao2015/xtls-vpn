# Use self-signed certificate for testing
SELF_SIGNED_CERT="false"
LETSENCRYPT_STAGING="false"
# Automatically determined if empty
PUBLIC_IP=""

# No CDN
# Owned certificate/local-site domain and the SNI used by REALITY clients.
REALITY_DOMAIN=""
# Optional comma-separated accepted REALITY names. Empty uses REALITY_DOMAIN and
# XHTTP_DOMAIN. REALITY_DOMAIN is always included for generated clients.
REALITY_SERVER_NAMES=""
# Enable SNI sniffing and public TCP/443 forwarding for other names. This exposes
# an unauthenticated public TLS relay; owned names and no-SNI traffic stay local.
REALITY_FORWARD_ALL_SNI="false"
# CDN
XHTTP_DOMAIN=""

XRAY_PATH="/my/very/long/path"

REALITY_DOMAIN_PROXY_SITE="www.example.com"
XHTTP_DOMAIN_PROXY_SITE="www.example.com"
